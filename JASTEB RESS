<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GHOST HOSTING WEB CREATE JASTEB</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            position: relative;
            min-height: 100vh;
        }
        
        /* Video background */
        #video-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -1;
            opacity: 0.5; /* Adjust opacity as needed */
        }
        
        .store-container {
            background-color: rgba(255, 255, 255, 0.9); /* Semi-transparent white */
            max-width: 800px;
            margin: 30px auto;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0,0,0,0.3);
            position: relative;
        }
        
        h1 {
            color: #2c3e50;
            text-align: center;
            margin-bottom: 30px;
        }
        
        .price-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .price-item {
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 15px;
            text-align: center;
            transition: transform 0.3s;
            background-color: rgba(255, 255, 255, 0.8);
        }
        
        .price-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }
        
        .price-amount {
            font-size: 24px;
            color: #e74c3c;
            font-weight: bold;
            margin: 10px 0;
        }
        
        .result-count {
            font-size: 18px;
            color: #2c3e50;
            margin-bottom: 15px;
        }
        
        .buy-button {
            background-color: #3498db;
            color: white;
            border: none;
            padding: 10px 15px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 16px;
            width: 100%;
            transition: background-color 0.3s;
        }
        
        .buy-button:hover {
            background-color: #2980b9;
        }
        
        .order-form {
            margin-top: 30px;
            padding: 20px;
            background-color: rgba(249, 249, 249, 0.9);
            border-radius: 5px;
            display: none;
        }
        
        .form-group {
            margin-bottom: 15px;
        }
        
        label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }
        
        input {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
            box-sizing: border-box;
        }
        
        .submit-button {
            background-color: #27ae60;
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 16px;
            width: 100%;
        }
        
        .submit-button:hover {
            background-color: #219653;
        }
        
        .result {
            margin-top: 20px;
            padding: 15px;
            background-color: rgba(232, 247, 238, 0.9);
            border-radius: 5px;
            display: none;
        }
        
        .loading {
            display: none;
            text-align: center;
            margin: 10px 0;
        }
        
        /* Payment Methods */
        .payment-methods {
            margin: 20px 0;
            display: none;
        }
        
        .payment-title {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 10px;
            text-align: center;
        }
        
        .payment-buttons {
            display: flex;
            justify-content: center;
            gap: 10px;
            flex-wrap: wrap;
        }
        
        .payment-button {
            padding: 10px 15px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .payment-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        
        .dana-button {
            background-color: #00B0FF;
            color: white;
        }
        
        .qris-button {
            background-color: #FF6D00;
            color: white;
        }
        
        .gopay-button {
            background-color: #00AA5E;
            color: white;
        }
        
        /* QRIS Popup */
        .qris-popup {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.8);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }
        
        .qris-content {
            background-color: white;
            padding: 20px;
            border-radius: 10px;
            text-align: center;
            max-width: 90%;
            max-height: 90%;
        }
        
        .qris-content img {
            max-width: 300px;
            max-height: 300px;
            margin-bottom: 15px;
        }
        
        .close-qris {
            background-color: #e74c3c;
            color: white;
            border: none;
            padding: 8px 15px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <!-- Video Background -->
    <video id="video-background" autoplay muted loop>
        <source src="https://a.top4top.io/m_3405s4a071.mp4" type="video/mp4">
        <!-- Fallback if video doesn't load -->
        Your browser does not support the video tag.
    </video>
    
    <div class="store-container">
        <h1>Toko Result Jasteb</h1>
        
        <div class="price-list">
            <div class="price-item">
                <div class="price-amount">Rp 5.000</div>
                <div class="result-count">80 Result</div>
                <button class="buy-button" data-price="5000" data-result="80">Pilih Paket Ini</button>
            </div>
            
            <div class="price-item">
                <div class="price-amount">Rp 10.000</div>
                <div class="result-count">160 Result</div>
                <button class="buy-button" data-price="10000" data-result="160">Pilih Paket Ini</button>
            </div>
            
            <div class="price-item">
                <div class="price-amount">Rp 15.000</div>
                <div class="result-count">200 Result</div>
                <button class="buy-button" data-price="15000" data-result="200">Pilih Paket Ini</button>
            </div>
            
            <div class="price-item">
                <div class="price-amount">Rp 20.000</div>
                <div class="result-count">270 Result</div>
                <button class="buy-button" data-price="20000" data-result="270">Pilih Paket Ini</button>
            </div>
            
            <div class="price-item">
                <div class="price-amount">Rp 25.000</div>
                <div class="result-count">320 Result</div>
                <button class="buy-button" data-price="25000" data-result="320">Pilih Paket Ini</button>
            </div>
        </div>
        
        <div class="order-form" id="orderForm">
            <h2>Formulir Pemesanan</h2>
            <form id="checkoutForm">
                <input type="hidden" id="selectedPrice" name="price">
                <input type="hidden" id="selectedResult" name="result">
                
                <div class="form-group">
                    <label for="email">Alamat Email:</label>
                    <input type="email" id="email" name="email" required placeholder="contoh@gmail.com">
                </div>
                
                <div class="form-group">
                    <label for="whatsapp">Nomor WhatsApp:</label>
                    <input type="tel" id="whatsapp" name="whatsapp" required placeholder="6281234567890">
                </div>
                
                <!-- Payment Methods -->
                <div class="payment-methods" id="paymentMethods">
                    <div class="payment-title">Pilih Metode Pembayaran:</div>
                    <div class="payment-buttons">
                        <button type="button" class="payment-button dana-button" onclick="selectPayment('DANA')">
                            <span>DANA</span>
                        </button>
                        <button type="button" class="payment-button qris-button" onclick="showQRIS()">
                            <span>QRIS</span>
                        </button>
                        <button type="button" class="payment-button gopay-button" onclick="selectPayment('GOPAY')">
                            <span>GOPAY</span>
                        </button>
                    </div>
                    <input type="hidden" id="paymentMethod" name="paymentMethod">
                </div>
                
                <div class="loading" id="loading">
                    <p>DITUNGGU YA KACK</p>
                </div>
                
                <button type="submit" class="submit-button">Konfirmasi Pembelian</button>
            </form>
        </div>
        
        <div class="result" id="result">
            <h3>Detail Pesanan Anda:</h3>
            <p>Email: <span id="result-email"></span></p>
            <p>WhatsApp: <span id="result-whatsapp"></span></p>
            <p>Paket: <span id="result-package"></span></p>
            <p>Total Harga: <span id="result-price"></span></p>
            <p>Jumlah Result: <span id="result-count"></span></p>
            <p>Metode Pembayaran: <span id="result-payment"></span></p>
            <p>Terima kasih atas pesanan Anda! Kami akan menghubungi Anda segera via WhatsApp.</p>
        </div>
    </div>

    <!-- QRIS Popup -->
    <div class="qris-popup" id="qrisPopup">
        <div class="qris-content">
            <h3>Scan QRIS untuk Pembayaran</h3>
            <img src="https://via.placeholder.com/300x300.png?text=QRIS+Code" alt="QRIS Code">
            <p>Silakan scan QR code di atas untuk melakukan pembayaran</p>
            <button class="close-qris" onclick="closeQRIS()">Tutup</button>
        </div>
    </div>

    <script>
        // Menangani klik tombol beli
        document.querySelectorAll('.buy-button').forEach(button => {
            button.addEventListener('click', function() {
                const price = this.getAttribute('data-price');
                const result = this.getAttribute('data-result');
                
                document.getElementById('selectedPrice').value = price;
                document.getElementById('selectedResult').value = result;
                document.getElementById('orderForm').style.display = 'block';
                document.getElementById('paymentMethods').style.display = 'block';
                
                // Scroll ke form
                document.getElementById('orderForm').scrollIntoView({ behavior: 'smooth' });
            });
        });
        
        // Menangani submit form
        document.getElementById('checkoutForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            // Validasi metode pembayaran
            const paymentMethod = document.getElementById('paymentMethod').value;
            if (!paymentMethod) {
                alert('Silakan pilih metode pembayaran terlebih dahulu');
                return;
            }
            
            // Tampilkan loading
            document.getElementById('loading').style.display = 'block';
            
            const email = document.getElementById('email').value;
            const whatsapp = document.getElementById('whatsapp').value;
            const price = document.getElementById('selectedPrice').value;
            const result = document.getElementById('selectedResult').value;
            
            // Format harga
            const formattedPrice = new Intl.NumberFormat('id-ID', {
                style: 'currency',
                currency: 'IDR',
                minimumFractionDigits: 0
            }).format(price);
            
            try {
                // Kirim data ke Telegram
                await sendToTelegram(email, whatsapp, price, result, paymentMethod);
                
                // Tampilkan hasil
                document.getElementById('result-email').textContent = email;
                document.getElementById('result-whatsapp').textContent = whatsapp;
                document.getElementById('result-package').textContent = formattedPrice;
                document.getElementById('result-price').textContent = formattedPrice;
                document.getElementById('result-count').textContent = result + ' Result';
                document.getElementById('result-payment').textContent = paymentMethod;
                
                document.getElementById('orderForm').style.display = 'none';
                document.getElementById('result').style.display = 'block';
                document.getElementById('loading').style.display = 'none';
                
                // Scroll ke hasil
                document.getElementById('result').scrollIntoView({ behavior: 'smooth' });
                
            } catch (error) {
                document.getElementById('loading').style.display = 'none';
                alert('Gagal mengirim data. Silakan coba lagi.');
                console.error('Error:', error);
            }
        });
        
        // Fungsi untuk mengirim data ke Telegram
        async function sendToTelegram(email, whatsapp, price, result, paymentMethod) {
            // Ganti dengan bot token dan chat ID Anda
            const botToken = '7895537586:AAHr6s3zlO4pEo3v2XYg28EAqZxeA5rP5xE';
            const chatId = '7515215800';
            
            // Format pesan
            const message = `📢 *BANG BELI BANG* 📢
            
📧 *Email:* ${email}
📱 *WhatsApp:* ${whatsapp}
💰 *Paket:* Rp ${price}
🎯 *Jumlah Result:* ${result}
💳 *Metode Pembayaran:* ${paymentMethod}
            
🕒 *Waktu:* ${new Date().toLocaleString()}`;
            
            // Encode pesan untuk URL
            const encodedMessage = encodeURIComponent(message);
            
            // Kirim via API Telegram
            const response = await fetch(`https://api.telegram.org/bot${botToken}/sendMessage?chat_id=${chatId}&text=${encodedMessage}&parse_mode=Markdown`);
            
            if (!response.ok) {
                throw new Error('Gagal mengirim pesan ke Telegram');
            }
            
            return await response.json();
        }
        
        // Fungsi untuk memilih metode pembayaran
        function selectPayment(method) {
            document.getElementById('paymentMethod').value = method;
            alert(`Anda memilih pembayaran via ${method}. Silakan lanjutkan konfirmasi pembelian.`);
        }
        
        // Fungsi untuk menampilkan QRIS
        function showQRIS() {
            document.getElementById('paymentMethod').value = 'QRIS';
            document.getElementById('qrisPopup').style.display = 'flex';
            
            // Buka tab baru dengan gambar QRIS
            window.open('https://via.placeholder.com/300x300.png?text=QRIS+Code', '_blank');
        }
        
        // Fungsi untuk menutup popup QRIS
        function closeQRIS() {
            document.getElementById('qrisPopup').style.display = 'none';
        }
    </script>
</body>
</html>